# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres connection string (Neon dashboard > Connect). Use a dev branch locally.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Passcode a grown-up types into the footer "grown-up unlock" to enable add/edit/delete.
GROWNUP_PASSCODE=choose-something-long-and-memorable

# Secret used to sign the unlock cookie. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Hardcover API token (hardcover.app > Settings > API). Optional: without it the
# "Up Next" series shelf is simply hidden.
HARDCOVER_TOKEN=
